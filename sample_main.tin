#session bd1 mud.dusk.org 7000
<account name>
<password>
#ACTION {%1 slaps you} {assist} {1}
#action {%1 says, 'Turtle.'} {turtle} {1}
#action {%1 says, 'Aggro.'} {aggro} {1}
#action {%1 says, 'Trip.'} {trip;legsweep;sweep} {1}
#action {%1 says, 'Circle.'} {circle all} {1}
#action {%1 says, 'Chop.'} {chop all;cleave all;haymaker all} {1}
#action {%1 says, 'Stab.'} {stab all;thrust all;jab all;punch all} {1}
#action {%1 beckons for you to follow} {follow %1} {1}
#action {You say, 'Trip.'} {trip all;sweep all;legsweep all} {1}
#action {Someone to the %1 says, 'Come.'} {flee %1}
#action {You see here a basin.} {put ore basin;scan;smelt}
#action {The material drains through the funnel and down into the trough below the smelter, where it begins to cool.} {scan;d}
#action {You see here a stone trough} {get all trough}
#action {%1 says, 'Rescue.'} {rescue %1}
#ACTION {You have defeated %0} {dem all.key;dem all.mon}
#alias la learn all
#alias ca circle all
#alias 1 {'stab}
#alias 2 {'chop}
#alias 3 {'trip}
#alias 4 {'circle}
#alias 5 {'turtle}
#alias 6 {'aggro}
#alias , {legsweep all;sweep all;trip all}
#ALIAS {mo} {move rock;move crate;move tree;move block;move brush;move stone;move altar;move rug;move map;move tile}
#alias 7 {'Rescue}
